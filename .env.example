# Create a project at https://supabase.com and copy these values from
# Project Settings > API. Never put the service-role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Public OAuth web-client ID used for temporary, read-only Gmail scans.
# Never put a Google client secret in a Vite variable.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
