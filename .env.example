# Create a project at https://supabase.com and copy these values from
# Project Settings > API. Never put the service-role key in this file.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional. Only needed to enable the "Connect Gmail (beta)" live-scan
# button on the email-history page — see SETUP.md step 5. Leaving this
# unset is the default and hides that button entirely; the .mbox/.zip
# import flow works with no Google configuration at all.
# VITE_GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
